{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CytoCount",
  "version": "1.3.1",
  "identifier": "com.cytocount.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CytoCount",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* http://localhost:*; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "externalBin": ["binaries/viacell-backend"],
    "publisher": "Gabriel Candido Messias dos Santos",
    "copyright": "Copyright (C) 2026 Gabriel Candido - CNPEM",
    "homepage": "https://gcandid0.github.io/CytoCount/",
    "shortDescription": "Citometria por Imagem e Analise de Viabilidade Celular",
    "longDescription": "Software cientifico automatizado para contagem celular, analise de fluorescencia e suporte a formatos de microscopia confocal (Zeiss, Leica, Nikon, Olympus).",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "hooks.nsh",
        "languages": ["Portuguese", "English"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc3NEY3OTNGMzUwMEZEMDYKUldRRy9RQTFQM2xQZDF4ZmFscmVCZDByRnpZd0hkWnBCamNiNEFadHVya2VUUXVxZmtGU3M4K3YK",
      "endpoints": [
        "https://github.com/gcandid0/CytoCount/releases/latest/download/latest.json"
      ]
    }
  }
}
